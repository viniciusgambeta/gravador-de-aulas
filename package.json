{
  "name": "gravador-de-aulas",
  "productName": "Gravador de Aulas",
  "version": "1.7.0",
  "description": "Grava tela + câmera + microfone, edita e exporta videoaulas leves em MP4 (Windows).",
  "main": "main.js",
  "author": "Vinicius Gambeta",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.agenciadebolso.gravadordeaulas",
    "productName": "Gravador de Aulas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/icon.png",
      "main.js",
      "mde.js",
      "package.json",
      "preload.js",
      "src/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gravador de Aulas",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Gravador-de-Aulas-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "build/defaults",
        "to": "defaults",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viniciusgambeta/gravador-de-aulas.git"
  }
}
